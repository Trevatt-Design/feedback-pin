{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./src",
    "paths": {
      "compositions": ["./sds/ui/compositions"],
      "data": ["./sds/data"],
      "hooks": ["./sds/ui/hooks"],
      "icons": ["./sds/ui/icons"],
      "images": ["./sds/ui/images"],
      "layout": ["./sds/ui/layout"],
      "primitives": ["./sds/ui/primitives"],
      "utils": ["./sds/ui/utils"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
